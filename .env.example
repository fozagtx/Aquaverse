# Optional AI helpers. Leave AIMLAPI_KEY empty to run AquaVerse fully rule-based, at no cost.
# Copy this file to .env for `npm run dev` / `npm run preview`, or set the same variables on your host.

# Key from https://aimlapi.com. Used only on the server, never sent to the browser.
AIMLAPI_KEY=

# Very cheap chat model that rewords the narrator's sentence.
AIMLAPI_NARRATOR_MODEL=amazon/nova-micro-v1

# Upstream calls allowed per day (per server instance). Lower it if your balance is small.
AI_DAILY_CALL_LIMIT=400

# Set to 1 to switch every AI helper off without removing the key.
AI_DISABLED=
